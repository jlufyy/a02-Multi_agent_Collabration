# Copy to .env privately; never commit actual keys. Existing AMAP_API_KEY/AIPING_* are accepted.
AMAP_WEB_SERVICE_KEY=
AMAP_API_KEY=
AIPING_API_KEY=
AIPING_BASE_URL=https://aiping.cn/api/v1
AIPING_PRIMARY_MODEL=DeepSeek-V3.2
AIPING_SECONDARY_MODEL=Qwen3.8-27B

# DeepSeek direct API: defaults to A1 and A7 when configured (measured 2026-10-17).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_INPUT_CNY_PER_MILLION=
DEEPSEEK_OUTPUT_CNY_PER_MILLION=
# Explicit MODEL_ROUTES overrides these defaults, e.g. {"A1":"deepseek","A7":"aiping"}

# Optional independently configured providers. MODEL_ROUTES selects these instead of AIPing.
PRIMARY_KIND=openai-compatible
PRIMARY_API_KEY=
PRIMARY_BASE_URL=https://api.openai.com/v1
PRIMARY_MODEL=
PRIMARY_INPUT_CNY_PER_MILLION=
PRIMARY_OUTPUT_CNY_PER_MILLION=
SECONDARY_KIND=anthropic
SECONDARY_API_KEY=
SECONDARY_BASE_URL=https://api.anthropic.com/v1
SECONDARY_MODEL=
SECONDARY_INPUT_CNY_PER_MILLION=
SECONDARY_OUTPUT_CNY_PER_MILLION=
# MODEL_ROUTES={"A1":"primary","A7":"secondary"}
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRIPFLOW_JOB_TTL_SECONDS=1800
TRIPFLOW_MAX_JOB_SECONDS=180
TRIPFLOW_REQUEST_TIMEOUT_SECONDS=45
TRIPFLOW_MODEL_TIMEOUT_SECONDS=60
# A7 total wall-clock budget includes retries and schema repair; does not alter provider routing.
TRIPFLOW_CONTENT_TIMEOUT_SECONDS=45
TRIPFLOW_CONTENT_MAX_TOKENS=1600
TRIPFLOW_MAX_BODY_BYTES=524288
TRIPFLOW_MAX_JOBS=128
TRIPFLOW_MAX_CONCURRENT_JOBS=4
TRIPFLOW_RATE_LIMIT_PER_MINUTE=120
TRIPFLOW_MAX_MODEL_CALLS_PER_JOB=20
TRIPFLOW_MAX_TOKENS=4096
TRIPFLOW_DAILY_BUDGET_CNY=20
TRIPFLOW_ENABLE_DEMO=true
TRIPFLOW_ENABLE_KNOWLEDGE=true
# Search is separate from the LLM API. Auto-detects Tencent WSA, Tavily or Bocha.
TENCENTCLOUD_WSA_APIKEY=
TENCENTCLOUD_WSA_API_URL=https://api.wsa.cloud.tencent.com/SearchPro
# Select explicitly when multiple keys exist: TRIPFLOW_SEARCH_PROVIDER=tencent_wsa (or tavily/bocha).
TAVILY_API_KEY=
BOCHA_API_KEY=
# Optional compatible proxy: SEARCH_PROVIDER=tavily, SEARCH_API_KEY=..., SEARCH_BASE_URL=https://...
# Enable a cache only after obtaining the map provider's applicable permission.
TRIPFLOW_AMAP_CACHE_AUTHORIZED=false
TRIPFLOW_MAP_CACHE_TTL_SECONDS=0
PORT=8000
